version: "3.5"

# Distinct project name so this stack NEVER collides with the dev stack in
# docker-compose.yaml. Both files define an `icehrm` service; without this, Compose
# derives the project from the directory name (`icehrm-pro`) for both, and a testing
# `up`/`run`/`build` would recreate the dev web container and overwrite its image.
name: icehrm-testing

services:
  mysql-testing:
    image: mysql:8.0.32
    ports:
      # Loopback only — an unauthenticated MySQL on 0.0.0.0 is reachable by anything
      # on the same network (coffee-shop wifi, corporate LAN).
      - 127.0.0.1:9307:3306
    environment:
      MYSQL_ROOT_PASSWORD: IceHrmR00t
      MYSQL_USER: testing
      MYSQL_PASSWORD: testing
      MYSQL_DATABASE: icehrm
    volumes:
      - ./docker/init.sql:/docker-entrypoint-initdb.d/setup.sql
      - ./docker/testing/db_data:/var/lib/mysql

  icehrm:
    build:
      context: ./
      dockerfile: Dockerfile-testing
    ports:
      # 8090 is the port nginx actually listens on in this image
      # (docker/testing/config/nginx.conf, and Dockerfile-testing EXPOSE/HEALTHCHECK).
      # Dev uses 8080 and prod 8070; this mapping had been copied from dev, so the
      # container came up healthy — the healthcheck probes 8090 from inside — while
      # http://localhost:9380 hit container port 8080 where nothing was listening.
      - 9380:8090
    environment:
      ICE_CONFIG_FILE: ../docker/testing/config/config.php
    volumes:
      - .:/var/www/html
    extra_hosts:
      - "dascore.org:192.168.65.254"
      - "admin.dascore.org:192.168.65.254"

volumes:
  db_data:
