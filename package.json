{
  "name": "icehrm",
  "version": "",
  "description": "Simple HR Management",
  "main": "gulpfile.js",
  "directories": {
    "test": "test"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.9.0",
    "@babel/plugin-proposal-class-properties": "^7.8.3",
    "@babel/preset-env": "^7.9.0",
    "@babel/preset-react": "^7.9.4",
    "acorn": "^7.1.1",
    "babel-plugin-import": "^1.13.0",
    "babelify": "^10.0.0",
    "browserify": "^16.5.1",
    "browserify-css": "^0.15.0",
    "eslint": "^6.8.0",
    "eslint-config-airbnb": "^18.1.0",
    "eslint-plugin-import": "^2.20.2",
    "eslint-plugin-jsx-a11y": "^6.2.3",
    "eslint-plugin-react": "^7.19.0",
    "fs": "0.0.1-security",
    "gulp": "^4.0.2",
    "gulp-babel": "^8.0.0",
    "gulp-clean": "^0.4.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-copy": "^4.0.1",
    "gulp-if-else": "^1.0.3",
    "gulp-less": "^4.0.1",
    "gulp-minify": "^3.1.0",
    "gulp-obfuscate": "^0.2.9",
    "gulp-rename": "^2.0.0",
    "gulp-sourcemaps": "^2.6.5",
    "gulp-uglify": "^3.0.2",
    "gulp-uglify-es": "^2.0.0",
    "gulp-watch": "^5.0.1",
    "node-lessify": "^0.1.5",
    "path": "^0.12.7",
    "stdio": "^2.1.1",
    "vinyl-buffer": "^1.0.1",
    "vinyl-source-stream": "^2.0.0"
  },
  "dependencies": {
    "browserify-less": "0.0.1",
    "d3": "^5.9.1",
    "event-stream": "^4.0.1",
    "gulp-javascript-obfuscator": "^1.1.6",
    "qrcode": "^1.3.3",
    "reqwest": "^2.0.5"
  },
  "scripts": {
    "setup": "npm install && cd web && npm install && cd ..",
    "docker:build": "docker compose -f docker-compose.yaml build",
    "docker:start": "docker compose -f docker-compose.yaml up",
    "docker:start:bg": "docker compose -f docker-compose.yaml up -d",
    "docker:stop": "docker compose -f docker-compose.yaml down",
    "asset:build": "gulp",
    "asset:build:prod": "gulp --eprod",
    "test": "npm run test:e2e && npm run test:smoke",
    "test:setup": "cd e2e && npm install && npm run install:browsers",
    "test:e2e": "cd e2e && npm run test:e2e",
    "test:e2e:headed": "cd e2e && npm run test:e2e:headed",
    "test:e2e:ui": "cd e2e && npm run test:e2e:ui",
    "test:smoke": "cd e2e && npm run test:smoke",
    "release:test:base": "docker build -t icehrm-release-runtime -f Dockerfile .",
    "release:test:up": "npm run release:test:base && docker compose -p icehrm-release-test -f docker-compose-release-test.yaml up -d --build",
    "release:test:update": "sh release-test-update.sh",
    "release:test:down": "docker compose -p icehrm-release-test -f docker-compose-release-test.yaml down",
    "release:test:fresh": "docker compose -p icehrm-release-test -f docker-compose-release-test.yaml down -v --rmi local --remove-orphans && npm run release:test:base && docker compose -p icehrm-release-test -f docker-compose-release-test.yaml up -d --build",
    "release:test:logs": "docker compose -p icehrm-release-test -f docker-compose-release-test.yaml logs -f"
  }
}
