    post:
      tags:
        - Employees
      summary: Create Employee
      requestBody:
        content:
          '*/*':
            schema:
              type: string
              example: >-
                "{\n  \"employee_id\": \"D100\",\n  \"first_name\": \"IceHrm
                123\",\n  \"middle_name\": \"Sample Ex1\",\n  \"last_name\":
                \"Employee\",\n  \"nationality\": \"35\",\n  \"birthday\":
                \"1984-03-17\",\n  \"gender\": \"Male\",\n  \"marital_status\":
                \"Married\",\n  \"ssn_num\": \"\",\n  \"nic_num\":
                \"294-38-3535\",\n  \"other_id\": \"294-38-3535\",\n 
                \"driving_license\": \"\",\n  \"employment_status\": \"3\",\n 
                \"job_title\": \"11\",\n  \"pay_grade\": \"2\",\n 
                \"work_station_id\": \"\",\n  \"address1\": \"2772 Flynn
                Street\",\n  \"address2\": \"Willoughby\",\n  \"city\":
                \"Willoughby\",\n  \"country\": \"US\",\n  \"province\":
                \"41\",\n  \"postal_code\": \"44094\",\n  \"home_phone\":
                \"440-953-4578\",\n  \"mobile_phone\": \"440-953-4578\",\n 
                \"work_phone\": \"440-953-4578\",\n  \"work_email\":
                \"icehrm+admin@web-stalk.com\",\n  \"private_email\":
                \"icehrm+admin@web-stalk.com\",\n  \"joined_date\":
                \"2005-08-03\",\n  \"confirmation_date\": \"0000-00-00\",\n 
                \"supervisor\": \"2\",\n  \"indirect_supervisors\":
                \"[\\\"3\\\",\\\"4\\\"]\",\n  \"department\": \"1\",\n 
                \"termination_date\": \"0000-00-00\",\n  \"status\":
                \"Active\",\n  \"approver1\": \"5\",\n  \"approver2\": \"6\",\n 
                \"approver3\": \"7\"\n}"
      parameters:
        - name: Authorization
          in: header
          schema:
            type: string
          example: Bearer {{accessToken}}
        - name: Content-Type
          in: header
          schema:
            type: string
          example: application/json
      responses:
        '200':
          description: Successful response
          content:
            application/json: {}
  /employees/1:
