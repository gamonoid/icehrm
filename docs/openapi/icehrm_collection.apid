      requestBody:
        content:
          '*/*':
            schema:
              type: string
              example: >-
                "{\n\t\"expense_date\": \"2019-02-04\",\n\t\"payment_method\":
                1,\n\t\"transaction_no\": \"1111\",\n\t\"payee\": \"Thilina
                Hasantha\",\n\t\"category\": 1,\n\t\"notes\":
                \"retre\",\n\t\"currency\": 42,\n\t\"amount\":
                10.000,\n\t\"attachment1\": \"0865880001550471336\"\n}"
      parameters:
        - name: Authorization
          in: header
