openapi: 3.0.0
info:
  title: IceHrmProApi
  version: 1.0.0
servers:
  - url: http://{{baseurl}}
tags:
  - name: Attendance
  - name: Employees
  - name: Directory
  - name: Leave
  - name: Meta
  - name: Expense
  - name: Charts
  - name: Tasks
  - name: Recruitment
paths:
  /attendance/1:
    get:
      tags:
        - Attendance
      summary: GET Attendance Entry
      parameters:
        - name: Authorization
          in: header
          schema:
            type: string
          example: Bearer {{accessToken}}
      responses:
        '200':
          description: Successful response
          content:
            application/json: {}
  /attendance:
    post:
      tags:
        - Attendance
      summary: Create Attendance Entry
      requestBody:
        content:
          '*/*':
            schema:
              type: string
              example: '"{\n  \"employee\": 3,\n  \"note\": \"Test1\"\n}"'
      parameters:
        - name: Authorization
          in: header
          schema:
            type: string
          example: Bearer {{accessToken}}
      responses:
        '200':
          description: Successful response
          content:
            application/json: {}
    get:
      tags:
        - Attendance
      summary: GET All Attendance
      parameters:
        - name: Authorization
          in: header
          schema:
            type: string
          example: Bearer {{accessToken}}
