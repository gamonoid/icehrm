      requestBody:
        content:
          '*/*':
            schema:
              type: string
              example: >-
                "{\n  \"id\" : 54,\n  \"employee_id\": \"D1012\",\n 
                \"first_name\": \"IceHrm 123\",\n  \"middle_name\": \"Sample
                Ex1\",\n  \"last_name\": \"Employee\",\n  \"nationality\":
                \"35\",\n  \"birthday\": \"1984-03-17\",\n  \"gender\":
                \"Male\",\n  \"marital_status\": \"Married\",\n  \"ssn_num\":
